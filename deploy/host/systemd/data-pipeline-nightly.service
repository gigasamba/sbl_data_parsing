# 새벽 배치 — nightly_batch.sh scheduled(NIGHTLY_TIME부터 5분 창에만 run_pipeline.py). 설치: 운영 묶음 코드 폴더에서 `sudo bash deploy/host/scripts/host_ctl.sh timers`.
[Unit]
Description=RAG 새벽 배치 — run_pipeline.py(문서별 flow)를 NIGHTLY_TIME 시각에만(nightly_batch.sh scheduled)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
# 코드 폴더(host_ctl.sh timers가 채움) — settings.yaml은 그 폴더에서 찾는다
WorkingDirectory=@CODE_DIR@
ExecStart=/bin/bash deploy/host/scripts/nightly_batch.sh scheduled
TimeoutStartSec=6h
# 75 = 마감·다른 run_pipeline이 도는 중(pl-18) — 실패로 치지 않음
SuccessExitStatus=75
