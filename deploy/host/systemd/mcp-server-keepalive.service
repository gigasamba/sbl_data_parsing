# 근거 MCP(컨테이너 mcp-server — S6b 사용자 10-27, 옛 data-retrieval·rag-mcp) 상주 확인(준비만 — 설치·활성화는 사람): 꺼졌거나
# /health 응답이 없으면 다시 띄움(deploy/host/scripts/mcp_up.sh — S6b, 옛 docker/mcp_up.sh).
# 설치(코드 폴더 루트에서): sudo cp deploy/host/systemd/mcp-server-keepalive.* /etc/systemd/system/ && 아래 경로·사용자·DOCKER 수정
#   && sudo systemctl daemon-reload && sudo systemctl enable --now mcp-server-keepalive.timer
#   S6b — unit 이름이 바뀜(옛 data-retrieval-keepalive.*): 옛 unit은 `sudo systemctl disable --now data-retrieval-keepalive.timer` 뒤 파일 삭제(refactor.md C-29)
# 서버 컨테이너 도구 = root podman 하나(Environment=DOCKER=podman · User=root — 사용자 10-30 검토 B4). docker 서버면 DOCKER=docker, docker 그룹이 있으면 User=rag.
# /srv/rag/code/live = 지금 쓰는 코드 폴더 링크(zip을 푼 폴더 — `sudo ln -sfn <zip 폴더> /srv/rag/code/live`, README §5-0).
[Unit]
Description=근거 MCP 상주 확인·기동
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/rag/code/live
# 서버 배치 값은 아래 Environment= 줄이 설정 자리(I4) — WorkingDirectory는 systemd가 변수를 못 받아 같은 값을 직접 적음
# (코드 폴더를 옮기면 이 한 줄만 바꾼다). S6b — 호스트 스크립트는 코드 폴더 루트의 deploy/host/.
# 11-03(rn-03) — mcp_up.sh가 parse_document 작업 서비스 전용 컨테이너 data-pipeline-mcp도 살핀다(꺼졌으면 up -d).
# 설정 파일은 적지 않음 — mcp_up.sh가 settings_env.sh load_settings로 $SERVER_ENV_DIR/settings.yaml을 읽는다(S7e1, 사용자 10-27 Q4 — 옛 pipeline.env 대신).
#   설정 폴더를 옮기면 SERVER_ENV_DIR 한 줄만 바꾼다. settings.yaml이 다른 자리에 따로 있을 때만 Environment=SETTINGS_FILE=<파일>을 더한다.
#   RUN_ENV는 settings.yaml required.env.run_env에만 적는다. 호스트 python에는 PyYAML이 있어야 한다(settings_env.sh — host_env.py).
Environment=SERVER_ENV_DIR=/srv/rag/env
Environment=DOCKER=podman
ExecStart=/bin/bash deploy/host/scripts/mcp_up.sh
TimeoutStartSec=5min
