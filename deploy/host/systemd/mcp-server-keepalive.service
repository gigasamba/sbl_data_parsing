# 운영 묶음 상주 확인(Redis·parse_document 작업·검색 MCP) — 꺼졌거나 /health 응답이 없으면 다시 띄움(mcp_keepalive.sh). 설치: host_ctl.sh timers.
[Unit]
Description=근거 MCP 상주 확인·기동
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
# 코드 폴더(host_ctl.sh timers가 채움) — settings.yaml은 그 폴더에서 찾는다
WorkingDirectory=@CODE_DIR@
ExecStart=/bin/bash deploy/host/scripts/mcp_keepalive.sh
TimeoutStartSec=5min
