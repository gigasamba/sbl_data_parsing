{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "disabled_providers": [
    "opencode"
  ],
  "provider": {
    "internal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal LLM",
      "options": {
        "baseURL": "http://<internal model host>:<port>/v1",
        "apiKey": "{env:INTERNAL_LLM_API_KEY}"
      },
      "models": {
        "<model id>": {
          "name": "<model id>"
        }
      }
    }
  },
  "model": "internal/<model id>"
}
